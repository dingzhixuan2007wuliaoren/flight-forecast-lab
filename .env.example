# Optional free-tier key for AirLabs route and airport-operation data.
# Leave blank to use the no-key traffic proxy and model-prior fallbacks.
AIRLABS_API_KEY=

# Strict future-date fare verification through SerpApi Google Flights.
# Only search results that also pass booking_token verification may populate the
# main comparison list. No timetable projection or model-only flight is substituted.
FLIGHT_OFFER_PROVIDER=serpapi
SERPAPI_API_KEY=

# SerpApi Free currently includes 250 successful searches per provider billing
# period and 50 searches/hour. The period follows plan_renewal_date, not the
# calendar month. Initial searches and booking_token follow-ups share the limit.
# Values above 250 are clamped; omitted/invalid values remain capped.
SERPAPI_MONTHLY_LIMIT=250

# Set to 0 for fully offline development and deterministic demos.
EXTERNAL_CONTEXT_ENABLED=1

MODEL_DIR=artifacts/demo
