# Optional free-tier key for AirLabs route and airport-operation data.
# Leave blank to use the no-key traffic proxy and model-prior fallbacks.
AIRLABS_API_KEY=
# Required whenever AIRLABS_API_KEY is set. Missing/invalid values fail closed;
# values above the free-tier ceiling are clamped to 1,000 shared calls/month.
# Every AirLabs transport reserves one call in the same cross-process SQLite
# ledger. Valid response request.key limits_by_month/limits_total counters can
# only tighten, never expand, this local ceiling.
AIRLABS_MONTHLY_CALL_LIMIT=1000
# Optional durable ledger override. Both context and timetable calls share it.
AIRLABS_USAGE_DB=runtime/airlabs-usage.sqlite3

# Strict future-date fare verification through supported Google Flights sources.
# In auto mode every configured/released strict source is queried. When at least
# two sources actually run, their independently verified rows are exposed through
# strict_fare_aggregate/provider_runs and equivalent full itinerary+cabin rows
# retain only the lowest verified fare. No reference or model flight is substituted.
FLIGHT_OFFER_PROVIDER=auto
SERPAPI_API_KEY=

# SerpApi Free currently includes 250 successful searches per provider billing
# period and 50 searches/hour. The period follows plan_renewal_date, not the
# calendar month. Initial searches and booking_token follow-ups share the limit.
# Values above 250 are clamped; omitted/invalid values remain capped.
SERPAPI_MONTHLY_LIMIT=250

# SearchAPI.io is an additional strict source in auto aggregation. Its free signup
# allocation is 100 lifetime account requests and does not renew monthly. The old SEARCHAPI_MONTHLY_LIMIT
# name is accepted only for backward compatibility; use the truthful lifetime name.
SEARCHAPI_API_KEY=
SEARCHAPI_LIFETIME_LIMIT=100

# Ignav remains ignav_quarantine by default. It becomes the separately identified
# ignav_verified_fares strict source only when both release switches below are 1
# and controlled validation has established the free/no-payment account boundary.
# Its allowance is at most 1,000 lifetime account requests, not monthly.
IGNAV_API_KEY=
IGNAV_LIFETIME_LIMIT=1000
IGNAV_STRICT_RELEASE=0
IGNAV_FREE_ACCOUNT_ATTESTED=0

# Optional Scrape.do Google Flights listing-coverage snapshot. This source is
# permanently reference-only: it cannot create a strict offer or booking link.
# Each uncached economy query costs 10 credits. Before every such attempt, the
# backend calls Scrape.do /info and proceeds only for an active account whose
# provider capacity is at most the documented 1,000-credit free allowance and
# whose remaining balance is at least 10. The local limit is also clamped to
# 1,000, so raising this value cannot enable paid capacity.
SCRAPE_DO_API_TOKEN=
SCRAPE_DO_MONTHLY_CREDIT_LIMIT=1000
# Optional durable local ledger path; the default is under artifacts/runtime.
SCRAPE_DO_USAGE_DB=

# OpenSky supplies current trajectory-density reference data only. Anonymous mode
# is active without credentials and locally hard-stops at 400 API credits/day.
OPENSKY_ENABLED=1
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_DAILY_CREDIT_LIMIT=400

# AeroDataBox supplies dated timetable references only and never a strict fare.
# The ledger adopts a new billing window only from trusted RapidAPI free-plan
# limit/remaining/reset headers. Without trustworthy reset evidence, all calls
# share one installation-lifetime 600-unit fail-safe; a calendar month is not a
# reset signal.
AERODATABOX_API_KEY=
AERODATABOX_MONTHLY_UNIT_LIMIT=600
# Optional shared ledger for OpenSky and AeroDataBox reference calls.
SUPPLEMENTAL_AVIATION_USAGE_DB=

# Set to 0 for fully offline development and deterministic demos.
EXTERNAL_CONTEXT_ENABLED=1

MODEL_DIR=artifacts/demo

# Optional full-site HTTP Basic authentication for public deployments. Leave the
# password blank for local development. Never commit a real password.
SITE_ACCESS_USERNAME=flight
SITE_ACCESS_PASSWORD=
