# Large or private datasets are never committed.
data/*.csv
data/*.parquet
data/*.zip
!data/.gitkeep

# Local training runs; the reproducible demo report is explicitly unignored.
artifacts/*
!artifacts/.gitkeep
!artifacts/demo/
!artifacts/demo/metrics.json
!artifacts/demo/metadata.json
!artifacts/demo/report.md
!artifacts/demo/model_bundle.joblib
